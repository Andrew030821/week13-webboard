<%- include('head') %>
<section class="account">
  <h1><%= title %></h1>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <form method="post" action="/users/reg" class="editor">
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <label>아이디<input name="userid" required maxlength="20" pattern="[a-z0-9_]{3,20}"
      placeholder="사용할 아이디 입력" autocomplete="username" aria-describedby="userid-hint"
      value="<%= values.userid || '' %>"></label>
    <small id="userid-hint">영문 소문자, 숫자, 밑줄 3~20자</small>
    <label>비밀번호<input name="passwd" type="password" required maxlength="128" minlength="8"
      placeholder="비밀번호 입력" autocomplete="new-password" aria-describedby="password-hint"></label>
    <small id="password-hint">8자 이상</small>
    <label>이름<input name="name" required maxlength="20" placeholder="이름 입력" autocomplete="name"
      value="<%= values.name || '' %>"></label>
    <label>이메일<input name="email" type="email" required maxlength="50" placeholder="이메일 주소 입력"
      autocomplete="email" value="<%= values.email || '' %>"></label>
    <div class="actions">
      <button type="reset" class="quiet">초기화</button>
      <button type="submit">가입</button>
    </div>
  </form>
</section>
<%- include('foot') %>
