<%- include('head') %>
<article>
  <h1><%= post.title %></h1>
  <div class="meta"><span><%= post.name %></span><span><%= date(post.reg_date) %></span><span>조회 <%= post.hit %></span></div>
  <div class="content"><%= post.content %></div>
</article>
<div class="actions">
  <a class="button quiet" href="/board">목록</a>
  <% if (viewer && viewer.userid === post.userid) { %>
    <a class="button" href="/board/<%= post.idx %>/edit">수정</a>
    <form method="post" action="/board/<%= post.idx %>/delete" onsubmit="return confirm('이 게시글을 삭제하시겠습니까?')">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <button class="danger">삭제</button>
    </form>
  <% } %>
</div>
<%- include('foot') %>
